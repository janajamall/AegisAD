# Terraform plugin cache — never commit this
.terraform/
.terraform.lock.hcl

# Terraform state files — contain sensitive data
*.tfstate
*.tfstate.backup

# Terraform plan output
*.tfplan

# OS files
.DS_Store
Thumbs.db
# reportlab and dependencies installed locally for Lambda packaging
lambdas/report/reportlab/
lambdas/report/PIL/
lambdas/report/Pillow/
lambdas/report/bin/
lambdas/report/charset_normalizer/
lambdas/report/*.dist-info/
lambdas/report/*.dist-info
lambdas/report/pillow.libs/
lambdas/report/*.so
lambdas/report/*.so.*

# Lambda build artifacts (generated by archive_file at apply time)
lambdas/*/*.zip
terraform/*.zip

# Python caches
__pycache__/
*.pyc

# AWS / sensitive
.aws/
credentials.env